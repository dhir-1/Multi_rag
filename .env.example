# Groq API Key (get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Groq Token Pricing (USD per 1 Million Tokens)
GROQ_INPUT_COST_PER_M=0.10
GROQ_OUTPUT_COST_PER_M=0.20

# Embedding & Reranker Models (Run locally via ONNX / sentence-transformers)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=ms-marco-TinyBERT-L-2-v2

# Reranker Relevance & Routing Thresholds
RERANKER_ABSTENTION_THRESHOLD=0.25
RERANKER_FAST_PATH_THRESHOLD=0.60
RERANK_TOP_K=4

# Retrieval & Chunking Sizing
CHUNK_SIZE_WORDS=250
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K_PER_SUBQUERY=8
RETRIEVAL_MAX_TOTAL_CHUNKS=16

# Self-Correction Loop Cap
RAG_MAX_ITERATIONS=2
ROUTER_MAX_WORDS_SIMPLE=12

# Storage & Data Directories
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db
BM25_INDEX_PATH=./data/bm25_index.pkl
CHUNKS_JSON_PATH=./data/chunks.json
RAW_PAPERS_DIR=./data/raw_papers
